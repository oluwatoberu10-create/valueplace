# Copy to .env.local for local work, or add these in your hosting dashboard.
# Everything here is optional: the site runs without any of it.

# The WhatsApp number that receives orders: international format, digits only.
# Can also be typed directly into src/config/restaurant.ts instead.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional order recording in Supabase (see README). Server-side only: never prefix with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Password for the staff page at /admin. At least 12 characters.
ADMIN_PASSWORD=
